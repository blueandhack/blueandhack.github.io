<div class="wrap page">
  {%- if page.type == 'tags' %}
  {%- set tags = sorted_tags() %}
  <header class="page-head">
    <h1 class="page-head__title">{{ __('tags.title') }}</h1>
    <p class="page-head__intro">{{ __('tags.intro', tags.length, site.posts.length) }}</p>
  </header>
  <ul class="tag-cloud">
    {%- for t in tags %}
    <li><a class="ref ref--count" href="{{ url_for(t.path) }}"><span>#{{ t.name }}</span><span class="ref__n">{{ t.length }}</span></a></li>
    {%- endfor %}
  </ul>
  <section class="lanes-legend" aria-labelledby="branches-title">
    <h2 class="section-title" id="branches-title">{{ __('categories.title') }}</h2>
    <p class="section-hint">{{ __('categories.intro') }}</p>
    {% include '_partial/lanes.njk' %}
  </section>

  {%- elif page.type == 'categories' %}
  <header class="page-head">
    <h1 class="page-head__title">{{ __('categories.title') }}</h1>
    <p class="page-head__intro">{{ __('categories.intro') }}</p>
  </header>
  {% include '_partial/lanes.njk' %}

  {%- elif page.type == 'links' %}
  <header class="page-head">
    <h1 class="page-head__title">{{ __('links.title') }}</h1>
    <p class="page-head__intro">{{ __('links.intro') }}</p>
  </header>
  <section class="links-section" aria-labelledby="links-me">
    <h2 class="section-title" id="links-me">{{ __('links.me') }}</h2>
    {%- set socialStyle = 'cards' %}
    {% include '_partial/social.njk' %}
  </section>
  {%- if theme.links and theme.links.length %}
  <section class="links-section" aria-labelledby="links-friends">
    <h2 class="section-title" id="links-friends">{{ __('links.friends') }}</h2>
    <ul class="blogroll">
      {%- for l in theme.links %}
      <li><a href="{{ l.url }}" rel="noopener">{{ l.name }}</a><span class="blogroll__host">{{ l.url | replace('https://', '') | replace('http://', '') | replace('www.', '') | replace(r/\/$/, '') }}</span></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
  {%- if page.content | trim %}<div class="prose" data-prose>{{ page.content }}</div>{% endif %}

  {%- else %}
  {%- set orig = original_for(page) %}
  {%- set enPage = null if orig else translation_for(page) %}
  <header class="page-head">
    <h1 class="page-head__title">{{ page.title }}</h1>
    {%- if enPage %}
    <p class="page-head__intro"><a class="lang-switch" href="{{ url_for(enPage.path) }}" hreflang="en" lang="en">{{ __('translation.read_english') }}</a></p>
    {%- endif %}
    {%- if orig %}
    <p class="translation-note">
      {{ __('translation.note') }}
      <a href="{{ url_for(orig.path) }}" hreflang="zh-CN">{{ __('translation.read_original') }}</a>
    </p>
    {%- endif %}
  </header>
  {%- if page.profiles %}
  <section class="profiles" aria-labelledby="profiles-title">
    <h2 class="visually-hidden" id="profiles-title">{{ __('social.find_me') }}</h2>
    {%- set socialStyle = 'labels' %}
    {% include '_partial/social.njk' %}
  </section>
  {%- endif %}
  <div class="prose" data-prose lang="{{ content_lang(page) }}">
    {{ page.content }}
  </div>
  {%- if theme.disqus.shortname and page.comments %}
  <section class="comments" id="comments" aria-labelledby="comments-title">
    <h2 class="section-title" id="comments-title">{{ __('post.comments') }}</h2>
    <div id="disqus_thread" data-disqus data-url="{{ page.permalink }}" data-identifier="{{ page.path }}" data-title="{{ page.title }}">
      <button class="button" type="button" data-load-comments>{{ __('post.load_comments') }}</button>
    </div>
  </section>
  {%- endif %}
  {%- endif %}
</div>
