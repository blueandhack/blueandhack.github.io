{#- Expects `graph` (from commit_graph()) and optional `showHead` in context. -#}
<ol class="graph" style="--graph-w: {{ graph.width }}px" data-graph>
  {%- for row in graph.rows %}
  {%- if row.type == 'tag' %}
  <li class="graph-row graph-row--tag" aria-hidden="true" style="--i: {{ loop.index0 }}">
    <span class="graph-row__lanes">
      {%- for s in row.segs %}<span class="seg seg--{{ s.kind }}" style="--x: {{ s.x }}; --c: var(--lane-{{ s.color }})"></span>{% endfor %}
      <span class="tag-mark"></span>
    </span>
    <span class="tag-label">v{{ row.year }}</span>
  </li>
  {%- else %}
  {%- set post = row.post %}
  <li class="graph-row graph-row--commit" style="--c: var(--lane-{{ row.color }}); --i: {{ loop.index0 }}" data-row>
    <span class="graph-row__lanes" aria-hidden="true">
      {%- for s in row.segs %}<span class="seg seg--{{ s.kind }}" style="--x: {{ s.x }}; --c: var(--lane-{{ s.color }})"></span>{% endfor %}
      {%- if row.curves.length %}
      <svg class="curves" width="{{ graph.width }}" height="{{ graph.svgHeight }}" viewBox="0 0 {{ graph.width }} {{ graph.svgHeight }}">
        {%- for c in row.curves %}<path d="{{ c.d }}" style="stroke: var(--lane-{{ c.color }})"/>{% endfor %}
      </svg>
      {%- endif %}
      <span class="dot{% if row.x == 0 %} dot--main{% endif %}" style="--x: {{ row.x }}"></span>
    </span>
    {#- Posts with an English translation are listed by it (the site's default language);
        the 中文 chip links to the original. -#}
    {%- set enRow = translation_for(post) %}
    {%- set shown = enRow or post %}
    <article class="commit" lang="{{ content_lang(shown) }}">
      <h2 class="commit__title"><a href="{{ url_for(shown.path) }}" data-row-link>{{ shown.title }}</a></h2>
      <p class="commit__meta" lang="en">
        <code class="commit__hash">{{ commit_hash(post) }}</code>
        {%- if showHead and row.first %}<span class="ref ref--head">{{ __('home.head') }}</span>{% endif %}
        <time datetime="{{ date_xml(post.date) }}">{{ date(post.date, 'YYYY-MM-DD') }}</time>
        <span>{{ __('min_read', reading_minutes(shown.content)) }}</span>
        <span class="branch">{{ row.key }}</span>
        {%- if enRow %}<a class="alt-lang" href="{{ url_for(post.path) }}" hreflang="zh-CN" lang="zh-CN" title="{{ post.title }}">中文</a>{% endif %}
        {%- if theme.disqus.shortname and post.comments !== false %}<a class="comment-count" href="{{ url_for(shown.path) }}#comments" data-comments="{{ post.path }}" hidden><svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z"/></svg><span></span></a>{% endif %}
      </p>
      {%- set summary = summary_text(shown) %}
      {%- if summary %}<p class="commit__summary">{{ summary }}</p>{% endif %}
    </article>
  </li>
  {%- endif %}
  {%- endfor %}
</ol>
