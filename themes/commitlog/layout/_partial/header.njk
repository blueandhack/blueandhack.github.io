<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="{{ url_for('/') }}" aria-label="{{ config.title }}">
      <svg class="brand__mark" width="32" height="32" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
        <path d="M0 0h3v1h-3zM4 0h1v1h-1zM7 0h1v1h-1zM9 0h1v1h-1zM11 0h3v1h-3zM0 1h1v1h-1zM2 1h1v1h-1zM4 1h1v1h-1zM7 1h1v1h-1zM9 1h1v1h-1zM11 1h1v1h-1zM0 2h3v1h-3zM4 2h1v1h-1zM7 2h1v1h-1zM9 2h1v1h-1zM11 2h3v1h-3zM0 3h1v1h-1zM2 3h1v1h-1zM4 3h1v1h-1zM7 3h1v1h-1zM9 3h1v1h-1zM11 3h1v1h-1zM0 4h3v1h-3zM4 4h2v1h-2zM7 4h3v1h-3zM11 4h3v1h-3zM1 6h4v1h-4zM6 6h2v1h-2zM9 6h1v1h-1zM11 6h4v1h-4zM1 7h1v1h-1zM4 7h1v1h-1zM6 7h2v1h-2zM9 7h1v1h-1zM11 7h1v1h-1zM14 7h1v1h-1zM1 8h4v1h-4zM6 8h1v1h-1zM8 8h2v1h-2zM11 8h1v1h-1zM14 8h1v1h-1zM1 9h1v1h-1zM4 9h1v1h-1zM6 9h1v1h-1zM8 9h2v1h-2zM11 9h4v1h-4zM2 11h1v1h-1zM4 11h1v1h-1zM6 11h3v1h-3zM10 11h2v1h-2zM13 11h1v1h-1zM15 11h1v1h-1zM2 12h1v1h-1zM4 12h1v1h-1zM6 12h1v1h-1zM8 12h1v1h-1zM10 12h1v1h-1zM13 12h3v1h-3zM2 13h3v1h-3zM6 13h1v1h-1zM8 13h1v1h-1zM10 13h1v1h-1zM13 13h2v1h-2zM2 14h1v1h-1zM4 14h1v1h-1zM6 14h3v1h-3zM10 14h1v1h-1zM13 14h1v1h-1zM15 14h1v1h-1zM2 15h1v1h-1zM4 15h1v1h-1zM6 15h1v1h-1zM8 15h1v1h-1zM10 15h2v1h-2zM13 15h1v1h-1zM15 15h1v1h-1z"/>
      </svg>
      <span class="brand__name">{{ config.title }}</span>
    </a>
    <nav class="site-nav" aria-label="{{ __('nav.primary') }}">
      <ul>
        {%- for key, path in theme.menu %}
        {%- set active = (key == 'log' and (is_home() or is_post())) or (key != 'log' and page.path and ('/' + page.path).startsWith(path)) or (key == 'archive' and is_archive()) or (key == 'tags' and (is_tag() or page.type == 'tags')) or (key == 'stats' and page.type == 'stats') %}
        <li><a href="{{ url_for(path) }}"{% if active %} aria-current="page"{% endif %}>{{ __('nav.' + key) }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="site-tools">
      <button class="search-trigger" type="button" data-action="palette" aria-label="{{ __('search') }}">
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="m11 11 4 4"/></svg>
        <span class="search-trigger__label">{{ __('search') }}</span>
        <kbd class="search-trigger__kbd" data-mod-key>Ctrl K</kbd>
      </button>
      <button class="icon-button" type="button" popovertarget="palette-menu" aria-label="{{ __('palettes.title') }}" title="{{ __('palettes.title') }}">
        <svg class="icon-palette" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 0 0 5-5c0-4-4-7.2-9-7.2Z"/><circle cx="7.5" cy="11.5" r="1.4"/><circle cx="10" cy="7.5" r="1.4"/><circle cx="14.5" cy="7.5" r="1.4"/><circle cx="17" cy="11" r="1.4"/></svg>
      </button>
      <button class="icon-button" type="button" data-action="theme" aria-label="{{ __('theme_toggle') }}" title="{{ __('theme_toggle') }}">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      </button>
    </div>
  </div>
  {%- if is_post() or page.layout == 'translation' %}
  {%- set progressPost = original_for(page) if page.layout == 'translation' else page %}
  <div class="progress" aria-hidden="true"><div class="progress__bar" style="--c: var(--lane-{{ lane_color(lane_key(progressPost) if progressPost else main_branch()) }})"></div></div>
  {%- endif %}
  <div class="palette-menu" id="palette-menu" popover>
    <p class="palette-menu__title" id="palette-menu-title">{{ __('palettes.title') }}</p>
    <ul role="radiogroup" aria-labelledby="palette-menu-title">
      {%- for name in theme.palettes %}
      <li><button class="palette-option" type="button" role="radio" aria-checked="{{ 'true' if loop.first else 'false' }}" data-palette-value="{{ name }}"><span class="palette-swatch" aria-hidden="true"></span>{{ __('palettes.' + name) }}</button></li>
      {%- endfor %}
    </ul>
  </div>
</header>
