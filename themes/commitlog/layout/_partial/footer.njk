<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copy">© {{ config.since or '2010' }}–{{ current_year() }} {{ config.author }}</p>
    <ul class="site-footer__links">
      <li><a href="{{ url_for('/atom.xml') }}">{{ __('footer.rss') }}</a></li>
      {%- if theme.social.github %}<li><a href="{{ theme.social.github }}" rel="me noopener">GitHub</a></li>{% endif %}
      {%- if theme.social.x %}<li><a href="{{ theme.social.x }}" rel="me noopener">X</a></li>{% endif %}
    </ul>
    <p class="site-footer__hint">{{ __('footer.shortcuts') }}</p>
    <p class="site-footer__powered">{{ __('footer.powered') }}</p>
  </div>
</footer>
