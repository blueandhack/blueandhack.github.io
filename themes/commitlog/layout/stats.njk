{%- set s = blog_stats() %}
<div class="wrap page stats">
  <header class="page-head">
    <h1 class="page-head__title">{{ __('stats.title') }}</h1>
    <p class="page-head__intro">{{ __('stats.intro') }}</p>
  </header>

  <dl class="stats__facts">
    <div><dt>{{ __('stats.posts') }}</dt><dd>{{ format_number(s.total) }}</dd></div>
    <div><dt>{{ __('stats.characters') }}</dt><dd>{{ format_number(s.totalChars) }}</dd></div>
    <div><dt>{{ __('stats.busiest_year') }}</dt><dd>{{ s.busiest.year }} <small>({{ __('archive.year_count', s.busiest.posts) }})</small></dd></div>
    <div><dt>{{ __('stats.longest') }}</dt><dd><a href="{{ url_for(s.longest.post.path) }}">{{ s.longest.post.title }}</a> <small>({{ format_number(s.longest.chars) }})</small></dd></div>
  </dl>

  <section aria-labelledby="per-year">
    <h2 class="section-title" id="per-year">{{ __('stats.per_year') }}</h2>
    <table class="bars">
      <tbody>
        {%- for y in s.years %}
        <tr>
          <th scope="row"><a href="{{ url_for('/archives/' + y.year + '/') }}">{{ y.year }}</a></th>
          <td><span class="bars__bar" style="--w: {{ y.postPct }}%"></span></td>
          <td class="bars__n">{{ y.posts }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>

  <section aria-labelledby="chars-year">
    <h2 class="section-title" id="chars-year">{{ __('stats.chars_per_year') }}</h2>
    <table class="bars bars--alt">
      <tbody>
        {%- for y in s.years %}
        <tr>
          <th scope="row">{{ y.year }}</th>
          <td><span class="bars__bar" style="--w: {{ y.charPct }}%"></span></td>
          <td class="bars__n">{{ format_number(y.chars) }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>

  <section aria-labelledby="per-branch">
    <h2 class="section-title" id="per-branch">{{ __('stats.branches') }}</h2>
    <table class="bars">
      <tbody>
        {%- for b in s.branches %}
        <tr style="--c: var(--lane-{{ b.color }})">
          <th scope="row"><span class="branch">{{ b.key }}</span></th>
          <td><span class="bars__bar bars__bar--lane" style="--w: {{ b.pct }}%"></span></td>
          <td class="bars__n">{{ b.count }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>

  {% include '_partial/heatmap.njk' %}
</div>
