{%- set key = lane_key(page) %}
{%- set color = lane_color(key) %}
{%- set tocHtml = toc(page.content, { list_number: false, max_depth: 3 }) %}
{%- set enPage = translation_for(page) %}
<article class="post wrap" style="--c: var(--lane-{{ color }})" lang="{{ content_lang(page) }}">
  <header class="post-head">
    <p class="post-head__commit">
      <code>{{ __('commit') }} {{ commit_hash(page) }}</code>
      <a class="branch" href="{{ url_for(branch_path(key)) }}">{{ key }}</a>
      {%- if enPage %}<a class="lang-switch" href="{{ url_for(enPage.path) }}" hreflang="en" lang="en">{{ __('translation.read_english') }}</a>{% endif %}
    </p>
    <h1 class="post-head__title">{{ page.title }}</h1>
    <dl class="post-head__meta" lang="en">
      <div><dt>{{ __('author') }}</dt><dd>{{ page.author or config.author }}</dd></div>
      <div><dt>{{ __('date') }}</dt><dd><time datetime="{{ date_xml(page.date) }}">{{ date(page.date, 'MMMM D, YYYY') }}</time></dd></div>
      <div><dt>{{ __('reading') }}</dt><dd>{{ __('min_read', reading_minutes(page.content)) }}</dd></div>
    </dl>
  </header>

  <div class="post-layout{% if tocHtml %} has-toc{% endif %}">
    <div class="prose" data-prose>
      {{ page.content }}
    </div>
    {%- if tocHtml %}
    <aside class="toc" aria-labelledby="toc-title">
      <h2 class="toc__title" id="toc-title">{{ __('post.contents') }}</h2>
      {{ tocHtml }}
    </aside>
    {%- endif %}
  </div>

  <footer class="post-foot" lang="en">
    {%- set tags = post_tags(page) %}
    {%- if tags.length %}
    <ul class="refs" aria-label="{{ __('post.tags') }}">
      {%- for t in tags %}<li><a class="ref" href="{{ url_for(t.path) }}">#{{ t.name }}</a></li>{% endfor %}
    </ul>
    {%- endif %}

    <nav class="lineage" aria-label="{{ __('post.parent') }} / {{ __('post.child') }}">
      {%- if page.next %}
      <a class="lineage__link lineage__link--parent" rel="prev" href="{{ url_for(page.next.path) }}" data-older>
        <span class="lineage__label">{{ __('post.parent') }}</span>
        <span class="lineage__title">{{ page.next.title }}</span>
        <code class="lineage__hash">{{ commit_hash(page.next) }}</code>
      </a>
      {%- else %}<span></span>{% endif %}
      {%- if page.prev %}
      <a class="lineage__link lineage__link--child" rel="next" href="{{ url_for(page.prev.path) }}" data-newer>
        <span class="lineage__label">{{ __('post.child') }}</span>
        <span class="lineage__title">{{ page.prev.title }}</span>
        <code class="lineage__hash">{{ commit_hash(page.prev) }}</code>
      </a>
      {%- endif %}
    </nav>

    {%- set related = related_posts(page, 4) %}
    {%- if related.length %}
    <section class="related" aria-labelledby="related-title">
      <h2 class="section-title" id="related-title">{{ __('post.related') }}</h2>
      <ul>
        {%- for p in related %}
        {%- set rk = lane_key(p) %}
        <li style="--c: var(--lane-{{ lane_color(rk) }})">
          <a href="{{ url_for(p.path) }}">{{ p.title }}</a>
          <time datetime="{{ date_xml(p.date) }}">{{ date(p.date, 'YYYY-MM-DD') }}</time>
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {%- if theme.disqus.shortname and page.comments !== false %}
    <section class="comments" aria-labelledby="comments-title">
      <h2 class="section-title" id="comments-title">{{ __('post.comments') }}</h2>
      <div id="disqus_thread" data-disqus data-url="{{ page.permalink }}" data-identifier="{{ page.path }}" data-title="{{ page.title }}">
        <button class="button" type="button" data-load-comments>{{ __('post.load_comments') }}</button>
      </div>
    </section>
    {%- endif %}
  </footer>
</article>
